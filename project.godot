; Engine configuration file.
; VR Baseball Duel — DE Feel Test (Godot 4.7, OpenXR, PCVR via editor)

config_version=5

[application]

config/name="VR Baseball Duel - Feel Test"
config/description="DE feel-test for the VR Baseball Duel: enrolled motions, classifier, velocity calibration/boost, speed gun, watch-from-the-box mode. Not a game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[physics]

3d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.02, 0.045, 1)

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
